{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MunshiProposal",
  "description": "The only output an understanding model may produce. Anything else is treated as unclear.",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "slots", "confidence", "language_detected"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "pay_bill",
        "book_gas_cylinder",
        "refill_medicine",
        "message_child",
        "affirm",
        "deny",
        "repeat",
        "help",
        "pause",
        "unsupported_transfer",
        "unclear"
      ]
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "language_detected": { "type": "string", "minLength": 1 },
    "needs_clarification": { "type": "boolean" },
    "clarification_question": { "type": ["string", "null"] },
    "injection_suspected": { "type": "boolean" }
  }
}
