# ---------------------------------------------------------------------------
# Munshi — copy to .env for local use. Never commit real credentials.
# ---------------------------------------------------------------------------

# API
MUNSHI_ENV=demo
MUNSHI_DB=apps/api/var/munshi.db
MUNSHI_CONFIDENCE_THRESHOLD=0.60
MUNSHI_MAX_CLARIFICATIONS=2
MUNSHI_MAX_TURNS=20
MUNSHI_APPROVAL_TTL=900
MUNSHI_DEMO_SECOND_FACTOR=246810
MUNSHI_WEBHOOK_SECRET=whsec_demo_munshi_sandbox

# Web (public build-time values; the token is a demo-only child session)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_MUNSHI_TOKEN=demo-child-token
NEXT_PUBLIC_PARENT_NUMBER=9812345678

# Optional real adapters. None is required for the demo, and none is enabled
# until the vendor contract and credentials are verified.
# ANTHROPIC_API_KEY=
# MUNSHI_LLM_MODEL=
# TELEGRAM_BOT_TOKEN=
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
